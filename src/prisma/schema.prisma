// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User { 
  id  Int   @id @default(autoincrement())
  user_id String @unique //사용자 고유 아이디.
  password String //비밀번호
  user_level Int @default(0) //사용자 레벨 (0: 일반, 1: 관리자)
  last_login_date DateTime?  //마지막 로그인 날짜
  created_date DateTime //생성 날짜

  @@index([user_id, created_date])
}

model CollectionHistory {
  id  Int   @id @default(autoincrement())
  device_id Int?
  insect_name String
  image_file String
  address_sido String
  address_gungu String
  address_dong String
  address_detail String
  latitude Float
  longitude Float
  collect_count Int
  status String
  memo String
  created_date DateTime @default(now())

  // device Device? @relation(fields: [device_id], references: [id], onDelete: SetNull)
  @@index([device_id, created_date])
}

model Address {
  id  Int   @id @default(autoincrement())
  address_sido String
  address_gungu String
  address_dong String
  @@index([address_sido, address_gungu, address_dong])
}

model Statistics {
  id  Int   @id @default(autoincrement())
  good_count Int @default(0) //양호
  normal_count Int @default(0) //보통
  warning_count Int @default(0) //주의
  bad_count Int @default(0) //방제필요
}
